# Echo Bloom License Server — environment variables
# Copy to .env and fill in. NEVER commit .env.

# Ed25519 private key (base64url, no padding)
# Generate with: python3 -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   import base64
#   k = Ed25519PrivateKey.generate()
#   print('PRIVATE:', base64.urlsafe_b64encode(k.private_bytes_raw()).decode())
#   print('PUBLIC: ', base64.urlsafe_b64encode(k.public_key().public_bytes_raw()).decode())
# "
ECHO_BLOOM_PRIVATE_KEY=your-private-key-here

# Admin token for POST /generate (make it long and random)
ADMIN_TOKEN=your-admin-token-here

# Stripe webhook signing secret (from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Gmail App Password for sending license keys
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=your@gmail.com

# Where to log issued keys (JSONL, one key per line)
KEY_LOG=issued_keys.jsonl

# Server port
PORT=9000
