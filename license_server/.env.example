# Echo Bloom License Server — environment variables
# Copy to .env and fill in. NEVER commit .env or the private key.

# ── Signing key (Ed25519) ─────────────────────────────────────────────────────
# To generate a fresh keypair:
#   python3 -c "
#   from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
#   import base64
#   k = Ed25519PrivateKey.generate()
#   print('PRIVATE:', base64.urlsafe_b64encode(k.private_bytes_raw()).rstrip(b'=').decode())
#   print('PUBLIC: ', base64.urlsafe_b64encode(k.public_key().public_bytes_raw()).rstrip(b'=').decode())
#   "
# Put PRIVATE here. Put PUBLIC in license.py (_PUBLIC_KEY_B64).
ECHO_BLOOM_PRIVATE_KEY=your-private-key-here

# ── Admin token ───────────────────────────────────────────────────────────────
# Long random string — used for /admin/* endpoints
ADMIN_TOKEN=your-long-random-token-here

# ── Stripe ────────────────────────────────────────────────────────────────────
# Stripe Dashboard → Developers → Webhooks → endpoint secret
# Point the webhook at: https://your-server/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Gmail → Google Account → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
FROM_EMAIL=your@gmail.com

# ── Storage ───────────────────────────────────────────────────────────────────
DB_PATH=echo_bloom_licenses.db
TRIAL_DAYS=14

# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000
